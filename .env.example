# ==============================================================================
# HỆ THỐNG QUẢN LÝ XƯỞNG SẢN XUẤT (AI WORKSHOP SYSTEM) - FILE MẪU CẤU HÌNH .ENV
# ==============================================================================

# 1. CẤU HÌNH GOOGLE GEMINI AI
# Lấy API Key miễn phí tại: https://aistudio.google.com/
# Dán API key của bạn vào đây (ví dụ: GEMINI_API_KEY=AIzaSy...):
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (Mặc định: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. CẤU HÌNH FLASK SERVER
SECRET_KEY=dev_secret_key_change_in_production
FLASK_DEBUG=1
PORT=5000
HOST=0.0.0.0

# 3. CẤU HÌNH CƠ SỞ DỮ LIỆU
# Mặc định sử dụng SQLite (instance/workshop.db) khi USE_MYSQL=false
USE_MYSQL=false

# Nếu muốn kết nối MySQL (ví dụ qua XAMPP/WAMP), đổi USE_MYSQL=true và cấu hình bên dưới:
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=workshop_db
MYSQL_PORT=3306
